# Existing application infrastructure
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated exact normalized administrator email addresses.
CRM_ALLOWED_EMAILS=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Koinophobia Labs Leads <leads@koinophobialabs.com>"
NEXT_PUBLIC_SITE_URL=https://koinophobialabs.com

# Deliberate shared-Neon migration command only. Leave unset during builds/runtime.
ALLOW_DATABASE_MIGRATIONS=
DATABASE_PROVIDER=
# Secret direct connection; application DATABASE_URL may remain pooled.
DATABASE_URL_UNPOOLED=
# Non-secret endpoint identity copied independently from the Neon provider.
EXPECTED_NEON_ENDPOINT_ID=
EXPECTED_DATABASE_NAME=
EXPECTED_DATABASE_ROLE=
TARGET_DATABASE_ENVIRONMENT=

# Local development/test only. Requires a loopback DATABASE_URL and an exact true value.
ALLOW_UNMARKED_LOCAL_DATABASE=

# Optional AI Project Concierge enhancement. The deterministic flow works without these.
OPENAI_API_KEY=
CONCIERGE_OPENAI_MODEL=gpt-5.6-luna
CONCIERGE_OPENAI_BASE_URL=https://api.openai.com/v1

# Required for signed concierge handoffs; use at least 32 random characters.
CONCIERGE_SIGNING_SECRET=
